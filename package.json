{
  "name": "incomplete-url",
  "description": "Custom-remove features of a URL implementation.",
  "version": "5.0.0",
  "license": "MIT",
  "author": "Steven Vachon <contact@svachon.com> (https://svachon.com)",
  "repository": "github:stevenvachon/incomplete-url",
  "type": "module",
  "exports": "./dist/index.js",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cspell": "^10.0.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "build": "npm run build:spellcheck && npm run build:lint && npm run build:typecheck:supplemental && npm run build:compile",
    "build:compile": "tsc -p tsconfig.build.json",
    "build:lint": "prettier --check '**/*.{config.js,json,md,ts}' '!coverage/**' '!dist/**'",
    "build:spellcheck": "cspell '**/*.{config.js,json,md,ts}' '!coverage/**' '!dist/**' '!node_modules/**' --no-progress",
    "build:typecheck:supplemental": "tsc --project tsconfig.check.json",
    "prepublishOnly": "npm run build && npm test",
    "test": "npm run test:watch -- --reporter=verbose --run",
    "test:watch": "vitest dev --coverage --coverage.exclude=src/*.test.ts --coverage.include=src/*.ts --coverage.reporter=html --coverage.reporter=lcov --coverage.reporter=text"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "uri",
    "url",
    "whatwg"
  ]
}
